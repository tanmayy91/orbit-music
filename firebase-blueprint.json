{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Private authenticated Orbit Music listener profile and cloud sync preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the user." },
        "displayName": { "type": "string", "description": "Display name shown on cards and playlists." },
        "handle": { "type": "string", "description": "Unique lowercase listener handle for friend lookup." },
        "discordUsername": { "type": "string", "description": "Optional linked Discord handle." },
        "discordId": { "type": "string", "description": "Optional linked Discord user ID." },
        "arySyncEnabled": { "type": "boolean", "description": "Whether Ary conversations sync to Firestore." },
        "cardShared": { "type": "boolean", "description": "Whether the listening card is published to friends." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp when updated." }
      },
      "required": ["uid", "displayName", "handle", "arySyncEnabled", "cardShared", "createdAt", "updatedAt"]
    },
    "DirectoryEntry": {
      "title": "Listener Directory Entry",
      "description": "Exact-match handle lookup entry so friends can send requests without list scraping.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID." },
        "handle": { "type": "string", "description": "Lowercase listener handle." },
        "displayName": { "type": "string", "description": "Public display name." },
        "discordUsername": { "type": "string", "description": "Optional linked Discord username." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp when updated." }
      },
      "required": ["uid", "handle", "displayName", "createdAt", "updatedAt"]
    },
    "DiscordLookupEntry": {
      "title": "Discord Directory Entry",
      "description": "Exact-match Discord handle lookup entry pointing to the listener's Orbit UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID." },
        "discordUsername": { "type": "string", "description": "Normalized lowercase Discord username." },
        "handle": { "type": "string", "description": "Listener Orbit handle." },
        "displayName": { "type": "string", "description": "Public display name." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp when updated." }
      },
      "required": ["uid", "discordUsername", "handle", "displayName", "createdAt", "updatedAt"]
    },
    "ArySyncMessage": {
      "title": "Ary Sync Message",
      "description": "Synced conversation turn with the Ary playlist assistant.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant"], "description": "Message author role." },
        "text": { "type": "string", "description": "Message text content." },
        "changeSummaries": { "type": "array", "description": "Bounded summaries of applied playlist changes." },
        "focusedPlaylistTitle": { "type": "string", "description": "Optional playlist title in focus." },
        "seq": { "type": "integer", "description": "Monotonic client sequence index for stable ordering." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when created." }
      },
      "required": ["role", "text", "changeSummaries", "seq", "createdAt"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Pending or accepted friendship between two Orbit Music listeners.",
      "type": "object",
      "properties": {
        "memberUids": { "type": "array", "description": "Exact two participant UIDs." },
        "requesterUid": { "type": "string", "description": "UID that initiated the friend request." },
        "recipientUid": { "type": "string", "description": "UID that received the friend request." },
        "requesterName": { "type": "string", "description": "Requester display name." },
        "requesterHandle": { "type": "string", "description": "Requester handle." },
        "recipientName": { "type": "string", "description": "Recipient display name." },
        "recipientHandle": { "type": "string", "description": "Recipient handle." },
        "status": { "type": "string", "enum": ["pending", "accepted"], "description": "Request state." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp when updated." }
      },
      "required": ["memberUids", "requesterUid", "recipientUid", "requesterName", "requesterHandle", "recipientName", "recipientHandle", "status", "createdAt", "updatedAt"]
    },
    "ListeningCardSnapshot": {
      "title": "Listening Card Snapshot",
      "description": "Shareable listening stats card visible to owner and accepted friends.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID." },
        "ownerName": { "type": "string", "description": "Card holder name." },
        "handle": { "type": "string", "description": "Owner Orbit handle." },
        "discordUsername": { "type": "string", "description": "Optional linked Discord handle." },
        "persona": { "type": "string", "description": "Primary listening persona." },
        "sinceLabel": { "type": "string", "description": "Member-since label." },
        "hoursLabel": { "type": "string", "description": "Formatted listening time." },
        "plays": { "type": "integer", "description": "Total play count." },
        "artistCount": { "type": "integer", "description": "Distinct artists count." },
        "bestStreak": { "type": "integer", "description": "Best daily listening streak." },
        "topSongTitle": { "type": "string", "description": "Most played track title." },
        "topSongArtist": { "type": "string", "description": "Most played track artist line." },
        "topGenre": { "type": "string", "description": "Dominant genre label." },
        "topArtists": { "type": "array", "description": "Up to 4 formatted top artist lines." },
        "viewerUids": { "type": "array", "description": "Owner UID and accepted friends' UIDs." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp when updated." }
      },
      "required": ["uid", "ownerName", "handle", "persona", "hoursLabel", "plays", "artistCount", "bestStreak", "topArtists", "viewerUids", "createdAt", "updatedAt"]
    },
    "PlaylistInvite": {
      "title": "Playlist Invite",
      "description": "Exact-code invite lookup mapping an uppercase code to a collaborative playlist ID.",
      "type": "object",
      "properties": {
        "playlistId": { "type": "string", "description": "Target collaborative playlist ID." },
        "ownerId": { "type": "string", "description": "Playlist owner UID." },
        "title": { "type": "string", "description": "Playlist title." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp when updated." }
      },
      "required": ["playlistId", "ownerId", "title", "createdAt", "updatedAt"]
    },
    "CollabPlaylist": {
      "title": "Collaborative Playlist",
      "description": "Shared playlist edited in real time by its collaborators.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Playlist title." },
        "description": { "type": "string", "description": "Optional playlist description." },
        "ownerId": { "type": "string", "description": "Creator UID." },
        "ownerName": { "type": "string", "description": "Creator display name." },
        "inviteCode": { "type": "string", "description": "Shareable uppercase invite code." },
        "memberUids": { "type": "array", "description": "Bounded list of collaborator UIDs." },
        "memberNames": { "type": "array", "description": "Parallel display names for collaborators." },
        "trackCount": { "type": "integer", "description": "Current track count." },
        "trackDocIds": { "type": "array", "description": "Track document IDs for membership resync." },
        "coverUrl": { "type": "string", "description": "Optional cover artwork URL." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp when updated." }
      },
      "required": ["title", "ownerId", "ownerName", "inviteCode", "memberUids", "memberNames", "trackCount", "trackDocIds", "createdAt", "updatedAt"]
    },
    "CollabTrack": {
      "title": "Collaborative Playlist Track",
      "description": "A song entry inside a collaborative playlist.",
      "type": "object",
      "properties": {
        "playlistId": { "type": "string", "description": "Parent playlist ID." },
        "memberUids": { "type": "array", "description": "Denormalized collaborator UIDs from parent playlist." },
        "mediaId": { "type": "string", "description": "Orbit Music MediaId serialized value." },
        "title": { "type": "string", "description": "Track title." },
        "artistLine": { "type": "string", "description": "Formatted artist line." },
        "albumTitle": { "type": "string", "description": "Optional album title." },
        "artworkUrl": { "type": "string", "description": "Optional artwork URL." },
        "durationMs": { "type": "integer", "description": "Optional duration in milliseconds." },
        "addedByUid": { "type": "string", "description": "UID of the collaborator who added this track." },
        "addedByName": { "type": "string", "description": "Display name of the collaborator who added this track." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp when added." }
      },
      "required": ["playlistId", "memberUids", "mediaId", "title", "artistLine", "addedByUid", "addedByName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only listener account profile and cloud sync flags."
    },
    "/listenerDirectory/{handle}": {
      "schema": { "$ref": "#/entities/DirectoryEntry" },
      "description": "Exact-get handle lookup index for friend requests."
    },
    "/discordDirectory/{discordKey}": {
      "schema": { "$ref": "#/entities/DiscordLookupEntry" },
      "description": "Exact-get Discord handle lookup index for friend requests."
    },
    "/users/{userId}/aryMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ArySyncMessage" },
      "description": "Owner-only synced Ary conversation history."
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Bidirectional friendship and pending request records."
    },
    "/listeningCards/{userId}": {
      "schema": { "$ref": "#/entities/ListeningCardSnapshot" },
      "description": "Shared listening card snapshot scoped to owner and accepted friends."
    },
    "/playlistInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/PlaylistInvite" },
      "description": "Exact-code invite lookup mapping invite code to playlist ID."
    },
    "/collabPlaylists/{playlistId}": {
      "schema": { "$ref": "#/entities/CollabPlaylist" },
      "description": "Collaborative playlist metadata and bounded collaborator list."
    },
    "/collabPlaylists/{playlistId}/tracks/{trackDocId}": {
      "schema": { "$ref": "#/entities/CollabTrack" },
      "description": "Tracks belonging to a collaborative playlist."
    }
  }
}
